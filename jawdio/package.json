{
  "name": "jawdio",
  "version": "0.2.0",
  "private": true,
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Monnapse/JAWdio.git"
  },
  "scripts": {
    "dev": "concurrently \"next dev -H 0.0.0.0\" \"wait-on http://localhost:3000 && electron .\"",
    "clean:build": "node scripts/clean-build-artifacts.cjs",
    "build:web": "next build",
    "build": "npm run clean:build && npm run build:web && node scripts/prepare-electron.cjs",
    "start": "next start",
    "lint": "eslint",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "wavesurfer.js": "^7.12.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.monnapse.jawdio",
    "productName": "JAWdio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      ".next/standalone/**/*",
      "!.next/standalone/dist{,/**/*}",
      "!.next/standalone/src{,/**/*}",
      "!.next/standalone/scripts{,/**/*}",
      "!.next/standalone/README.md",
      "!.next/standalone/eslint.config.mjs",
      "!.next/standalone/next.config.ts",
      "!.next/standalone/postcss.config.mjs",
      "!.next/standalone/tsconfig.json",
      "!.next/standalone/tsconfig.tsbuildinfo",
      "!.next/standalone/package-lock.json"
    ],
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "win": {
      "icon": "public/jawdio.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
